# Copy this file to .env before starting the stack.
POSTGRES_DB=odontosys
POSTGRES_USER=odontosys
POSTGRES_PASSWORD=replace-with-a-local-postgres-password

# Must be at least 32 bytes for HS256. Generate a unique value per environment.
JWT_SECRET=replace-with-a-unique-32-byte-minimum-jwt-secret

FRONTEND_PORT=8080
BACKEND_PORT=9000
CORS_ORIGINS=http://localhost:8080

# Optional SMTP configuration. Leave blank to disable real email delivery locally.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
